{
  "name": "ballpark-daily",
  "version": "1.0.0",
  "private": true,
  "description": "Ballpark: a daily estimation game with five questions a day",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "test": "node --test tests/logic.test.js tests/calc.test.js tests/bank.test.js tests/worker.test.js",
    "build:bank": "node scripts/build-bank.mjs",
    "validate": "node scripts/validate-bank.mjs && node scripts/stamp-assets.mjs --check",
    "e2e": "node tests/e2e.mjs",
    "stamp": "node scripts/stamp-assets.mjs"
  },
  "engines": {
    "node": ">=20"
  },
